# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to git or share it with anyone.

# --- Gmail credentials ---
# EMAIL_ADDRESS is the full Gmail address the assistant logs in as.
# EMAIL_APP_PASSWORD is a 16-character Gmail "App Password" — NOT your normal
# Gmail login password. See README.md for how to generate one.
EMAIL_ADDRESS= tgfreaks8@gmail.com
EMAIL_APP_PASSWORD= yvnm kqcx baxn waeu

# --- OpenRouter (OpenAI-compatible API) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=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
# Browse models + pricing at https://openrouter.ai/models
# Model names are prefixed with the provider, e.g. "openai/gpt-4o-mini",
# "anthropic/claude-3.5-sonnet", "google/gemini-2.0-flash-001"
OPENROUTER_MODEL=openrouter/free
# Optional — shown on OpenRouter's public leaderboard, safe to leave blank
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=AI Email Assistant

# --- Optional overrides (defaults shown) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
KNOWLEDGE_BASE_PATH=knowledgebase.txt
MAX_EMAILS_TO_FETCH=15

# Flask session secret — set this to a random string in production
FLASK_SECRET_KEY=change-me-to-something-random
